# Copy to .env (never committed) and fill in. See README.md.
FPL_TEAM_ID=
NTFY_TOPIC=
# Autopilot: stays off unless this says on.
FPL_AUTOPILOT=off
# safe = free transfers only; all_planned = execute optimizer hits and chips too
FPL_AUTOPILOT_POLICY=safe
# updated_only = notify after an actual update or failure; early_and_late = advice windows
FPL_MESSAGE_FREQUENCY=early_and_late
FPL_REFRESH_TOKEN=
